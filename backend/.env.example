# Supabase: use the "Session pooler" connection string (Connect -> Session pooler),
# it looks like postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/vedikshaya
JWT_SECRET=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173

# Dr. Vedik chatbot — NVIDIA API (build.nvidia.com). Server-side only.
# Without it the chatbot falls back to keyword matching.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
